NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j

# AI planner credentials. Keep the replace- prefixed placeholders to run on the deterministic
# planning fallback; the planner treats any replace-* value as missing credentials.
AI_AND_API_KEY=replace-if-available
AI_AND_BASE_URL=https://replace-with-official-ai-and-endpoint/v1
AI_AND_MODEL=replace-with-approved-model

# Optional local planner. run_genesis_gui.sh enables this automatically when qwen3-vl:4b is
# already installed. It calls Ollama's loopback-only OpenAI-compatible endpoint and uses no secret.
OPENARM_LOCAL_PLANNER=0
OPENARM_OLLAMA_MODEL=qwen3-vl:4b

# Set to 1 to ask Genesis World for its GPU backend (default: CPU).
GENESIS_USE_GPU=0

# Set to 1 to open the Genesis native viewer window in this process (see run_genesis_gui.sh).
GENESIS_SHOW_VIEWER=0

# Planner mode. OPENARM_CAPABILITY_MODE=1 asks the model to plan every task and keeps the
# deterministic grammar as a labelled fallback; OPENARM_SHADOW_PLAN=1 keeps the rules as the
# answer but also asks the model and records what it would have said. The launcher turns
# capability mode on automatically when OPENARM_OLLAMA_MODEL is installed locally.
OPENARM_CAPABILITY_MODE=0
OPENARM_SHADOW_PLAN=0
