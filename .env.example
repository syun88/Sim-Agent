NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j

AI_AND_API_KEY=replace-if-available
AI_AND_BASE_URL=https://replace-with-official-ai-and-endpoint/v1
AI_AND_MODEL=replace-with-approved-model

# Simulation engine: mujoco (default, authoritative) or genesis (optional second engine).
SIM_BACKEND=mujoco
# Only used by the genesis engine: set to 1 to request the GPU backend.
GENESIS_USE_GPU=0
